    -- ==================== VÒNG LẶP CHÍNH (RENDER STEPPED) ====================
    RunService.RenderStepped:Connect(function()
        -- Cập nhật vị trí vòng tròn FOV theo tâm màn hình
        if AimFOVEnabled then
            local viewportSize = Camera.ViewportSize
            FOVRing.Position = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
        end

        -- 1. Xử lý HeadLock hoặc Aim FOV khi nhấn giữ bắn (MouseButton1)
        if HeadLockEnabled or (AimFOVEnabled and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)) then
            local closestTargetHead = nil
            local shortestDist = math.huge
            local viewportSize = Camera.ViewportSize
            local screenCenter = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
            
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
                    local targetHead = player.Character:FindFirstChild("Head")
                    
                    if humanoid and humanoid.Health > 0 and targetHead then
                        local screenPoint, onScreen = Camera:WorldToViewportPoint(targetHead.Position)
                        if onScreen then
                            local pos2D = Vector2.new(screenPoint.X, screenPoint.Y)
                            local dist = (pos2D - screenCenter).Magnitude
                            
                            -- Nếu bật Aim FOV thì giới hạn trong vòng tròn FOVRing.Radius, còn HeadLock thì bắt toàn màn hình
                            local validCondition = HeadLockEnabled or (AimFOVEnabled and dist <= FOVRing.Radius)
                            
                            if validCondition and dist < shortestDist then
                                shortestDist = dist
                                closestTargetHead = targetHead
                            end
                        end
                    end
                end
            end
            
            if closestTargetHead then
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, closestTargetHead.Position)
            end
        end

        -- 2. Xử lý Hitbox & ESP Nhân vật
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local char = player.Character
                local head = char:FindFirstChild("Head")
                local humanoid = char:FindFirstChildOfClass("Humanoid")
                
                if head and humanoid and humanoid.Health > 0 then
                    if HitboxEnabled then
                        head.Size = Vector3.new(4, 4, 4)
                        head.Transparency = 0.4
                        head.CanCollide = false
                        
                        local headColor = head:FindFirstChild("BaorModzHeadColor")
                        if not headColor then
                            headColor = Instance.new("SelectionBox")
                            headColor.Name = "BaorModzHeadColor"
                            headColor.Adornee = head
                            headColor.Color3 = Color3.fromRGB(255, 0, 0)
                            headColor.LineThickness = 0.05
                            headColor.Parent = head
                        end
                    else
                        local headColor = head:FindFirstChild("BaorModzHeadColor")
                        if headColor then headColor:Destroy() end
                    end

                    local charHighlight = char:FindFirstChild("BaorModzCharHighlight")
                    if ESPCharacterWallThroughEnabled then
                        if not charHighlight then
                            charHighlight = Instance.new("Highlight")
                            charHighlight.Name = "BaorModzCharHighlight"
                            charHighlight.Adornee = char
                            charHighlight.FillColor = Color3.fromRGB(0, 162, 255)
                            charHighlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                            charHighlight.FillTransparency = 0.85
                            charHighlight.OutlineTransparency = 0
                            charHighlight.Parent = char
                        end
                    else
                        if charHighlight then charHighlight:Destroy() end
                    end
                end
            end
        end

        -- 3. Xử lý ESP Weapon
        local allPlayers = Players:GetPlayers()
        table.insert(allPlayers, LocalPlayer)

        for _, player in ipairs(allPlayers) do
            if player.Character then
                for _, tool in ipairs(player.Character:GetChildren()) do
                    if tool:IsA("Tool") then
                        local weaponHighlight = tool:FindFirstChild("BaorModzWeaponHighlight")
                        if ESPWeaponEnabled then
                            if not weaponHighlight then
                                weaponHighlight = Instance.new("Highlight")
                                weaponHighlight.Name = "BaorModzWeaponHighlight"
                                weaponHighlight.Adornee = tool
                                weaponHighlight.FillColor = Color3.fromRGB(120, 255, 120)
                                weaponHighlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                                weaponHighlight.FillTransparency = 0.4
                                weaponHighlight.OutlineTransparency = 0
                                weaponHighlight.Parent = tool
                            end
                        else
                            if weaponHighlight then weaponHighlight:Destroy() end
                        end
                    end
                end
            end
        end
    end)
    print("BaorModz-V1 Menu Cheat Loaded Successfully!")
